    "model.hidden_units": [
      [
        4,
        4
      ],
      [
        8,
        4
      ]
    ],
    "optim.lr": [
      0.3
    ],
    "optim.momentum": [
      0.0
    ],
    "optim.name": [
      "sgd",
      "adam"
    ],
    "regularizer.l2": [
      0.0,
      3e-07,
      7e-07,
      1e-06
    ],
    "training.batch_size": [
      16
    ],
    "training.epochs": [
      800
    ]
  }
}